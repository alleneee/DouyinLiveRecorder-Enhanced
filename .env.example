# 环境配置
ENVIRONMENT=test

# 数据库配置 (MySQL 5.7)
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/live_recorder?charset=utf8mb4

# API配置
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# 录制配置
SEGMENT_DURATION=60
VIDEO_SAVE_TYPE=TS
VIDEO_SAVE_PATH=./downloads
VIDEO_RECORD_QUALITY=原画
FOLDER_BY_AUTHOR=true
CHECK_INTERVAL=30

# FFmpeg编码配置（强制关键帧模式）
FORCE_KEYFRAME_MODE=true  # 强制关键帧模式：确保精确分段但需重新编码视频
FFMPEG_PRESET=ultrafast  # 编码速度预设 (ultrafast/superfast/veryfast/faster/fast/medium)
FFMPEG_CRF=23  # 质量控制 (18-28，越小质量越高但文件越大)
FFMPEG_GOP_SECONDS=2  # GOP间隔（秒），建议2-4秒，越小切片越精确但编码负载越高
FFMPEG_ASSUMED_FPS=30  # 假设的视频帧率，用于计算GOP大小

# 并发控制
MAX_CONCURRENT_RECORDINGS=5  # 最大并发录制数量（防止资源耗尽）
MONITOR_THREAD_POOL_SIZE=10  # 监控线程池大小（轻量级，可以大一些）
RECORDING_THREAD_POOL_SIZE=5  # 录制线程池大小（重量级，需限制）

# 重试机制
MAX_RETRY_ATTEMPTS=3  # 录制失败最大重试次数
RETRY_DELAY_SECONDS=10  # 重试间隔（秒）
RETRY_BACKOFF_MULTIPLIER=2.0  # 重试延迟倍增因子（指数退避）

# 音频抽取配置
EXTRACT_AUDIO=true
AUDIO_FORMAT=mp3
AUDIO_BITRATE=128k

# Redis配置（可选，用于会话恢复）
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# 阿里云OSS配置
OSS_ENABLED=false
OSS_ACCESS_KEY_ID=your_access_key_id_here
OSS_ACCESS_KEY_SECRET=your_access_key_secret_here
OSS_BUCKET_NAME=your_bucket_name
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_INTERNAL_ENDPOINT=oss-cn-beijing-internal.aliyuncs.com
OSS_AUTO_DELETE_LOCAL=false

# 分片通知配置
SEGMENT_NOTIFICATION_BASE_URL=
# ============================================
# 50+直播间并发录制配置示例
# 适用场景：20分钟分片，高并发录制
# ============================================

# 环境标识
ENVIRONMENT=prod

# ============================================
# 数据库配置（推荐使用MySQL）
# ============================================
DB_DRIVER=mysql+pymysql
DB_USERNAME=root
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=douyinlive

# ============================================
# 录制配置
# ============================================
# 分段时长（秒）- 20分钟 = 1200秒
SEGMENT_DURATION=1200

# 录制方式：hls(推荐) / segment
SEGMENT_METHOD=hls

# 音频编码：copy(性能高) / aac(兼容性好)
AUDIO_CODEC_MODE=copy

# 视频格式
VIDEO_SAVE_TYPE=mp4
VIDEO_RECORD_FORMAT=ts

# 保存路径（建议使用SSD）
VIDEO_SAVE_PATH=./downloads

# ⚡ 核心参数：最大并发录制数
# 推荐配置：30-50（根据服务器性能调整）
MAX_CONCURRENT_RECORDINGS=50

# ============================================
# FFmpeg编码配置（性能优化）
# ============================================
# 编码预设：ultrafast(最快) / superfast / veryfast / faster
# 推荐：ultrafast（降低CPU占用）
FFMPEG_PRESET=ultrafast

# 质量控制（18-28，推荐23）
FFMPEG_CRF=23

# GOP间隔（秒，推荐2-4秒）
FFMPEG_GOP_SECONDS=2

# 假设帧率（用于计算GOP）
FFMPEG_ASSUMED_FPS=30

# ============================================
# 重试机制配置
# ============================================
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY_SECONDS=10
RETRY_BACKOFF_MULTIPLIER=2.0

# ============================================
# 线程池配置（关键优化）
# ============================================
# 监控线程池（建议 >= MAX_CONCURRENT_RECORDINGS）
MONITOR_THREAD_POOL_SIZE=50

# 录制线程池（建议 >= MAX_CONCURRENT_RECORDINGS）
RECORDING_THREAD_POOL_SIZE=50

# ============================================
# OSS上传队列配置（关键优化）
# ============================================
# 是否启用OSS
OSS_ENABLED=true

# 阿里云OSS配置
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret
OSS_BUCKET_NAME=your_bucket_name
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com

# ⚡ 内网Endpoint（ECS内网访问，大幅提升速度）
# 格式：oss-cn-beijing-internal.aliyuncs.com
OSS_INTERNAL_ENDPOINT=

# 上传后删除本地文件（推荐开启，节省磁盘）
OSS_AUTO_DELETE_LOCAL=true

# ⚡ 上传工作线程数（推荐10-20）
# 50个直播间 × 3分片/小时 = 150分片/小时
# 每分片2文件 = 300次上传/小时（平均QPS: 0.08/s）
OSS_UPLOAD_WORKERS=15

# 上传队列最大长度（先进先出FIFO）
OSS_UPLOAD_QUEUE_SIZE=500

# ============================================
# 音频抽取配置
# ============================================
EXTRACT_AUDIO=true
AUDIO_FORMAT=mp3
AUDIO_BITRATE=128k

# ============================================
# 其他配置
# ============================================
# 直播状态检查间隔（秒）
CHECK_INTERVAL=30

# 按主播分文件夹
FOLDER_BY_AUTHOR=true

# API配置
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false

# ============================================
# 性能优化建议
# ============================================
# 1. 使用SSD存储（磁盘IO是主要瓶颈）
# 2. 启用OSS内网Endpoint（上传速度提升3-5倍）
# 3. 调整MAX_CONCURRENT_RECORDINGS至实际需求
# 4. 监控系统资源（CPU、内存、磁盘IO、网络）
# 5. 考虑使用分布式部署（超过50个直播间）

# ============================================
# 预期资源占用（50直播间）
# ============================================
# CPU: 50-75% (10核)
# 内存: 12-15 GB
# 磁盘IO: 100-125 MB/s（写入）
# 网络: 100-250 MB/s（下载+上传）
# OSS QPS: 平均0.08/s，峰值可达100/s

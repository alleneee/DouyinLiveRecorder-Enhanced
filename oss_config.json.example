{
  "oss_config": {
    "access_key_id": "your_access_key_id",
    "access_key_secret": "your_access_key_secret",
    "endpoint": "oss-cn-hangzhou.aliyuncs.com",
    "bucket_name": "your_bucket_name",
    "path_template": "live-records/{date}/{room_id}-{streamer_name}/",
    "enable_upload": false,
    "upload_immediately": false,
    "delete_after_upload": false,
    "max_upload_threads": 3,
    "retry_times": 3,
    "chunk_size": 8388608
  },
  "description": {
    "access_key_id": "阿里云OSS访问密钥ID",
    "access_key_secret": "阿里云OSS访问密钥Secret",
    "endpoint": "OSS服务端点，根据你的bucket所在区域选择",
    "bucket_name": "OSS存储桶名称",
    "path_template": "上传路径模板，支持变量：{date}, {room_id}, {streamer_name}, {title}",
    "enable_upload": "是否启用OSS上传功能",
    "upload_immediately": "是否在录制完成后立即上传",
    "delete_after_upload": "上传成功后是否删除本地文件",
    "max_upload_threads": "最大上传线程数",
    "retry_times": "上传失败重试次数",
    "chunk_size": "分片上传大小（字节）"
  }
